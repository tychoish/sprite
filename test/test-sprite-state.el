(ert-deftest sprite-state/saved-new-desktop-is-not-restored-on-reenable ()
  (sprite-state-test/with-directory
    (let ((sprite-state-desktop-enabled t) (reads 0))
      (cl-letf (((symbol-function 'run-with-idle-timer) (lambda (&rest _) 'fake-timer))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'random) (lambda (_) 0))
                ((symbol-function 'desktop-read) (lambda (&rest _) (cl-incf reads) t))
                ((symbol-function 'desktop-save)
                 (lambda (dir)
                   (write-region "" nil (expand-file-name desktop-base-file-name dir)
                                 nil 'silent))))
        (sprite-state-global-mode 1)
        (sprite-state--desktop-save)
        (sprite-state-global-mode -1)
        (sprite-state-global-mode 1)
        (should (= reads 0))
        (sprite-state-global-mode -1)))))

(ert-deftest sprite-state/auto-save-paths-configured ()
  (sprite-state-test/with-directory
    (let ((sprite-state-auto-save-enabled t)
          (auto-save-file-name-transforms nil)
          (backup-directory-alist nil))
      (sprite-state-configure)
      (let ((path (sprite-state-path "backup/")))
        (should (file-directory-p path))
        (should (= #o700 (file-modes path)))
        (should (equal auto-save-file-name-transforms `((".*" ,path t))))
        (should (member (cons "." path) backup-directory-alist))))))

