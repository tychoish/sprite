;;; test-sprite-state.el --- State lifecycle tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Isolated tests for opt-in instance state and desktop persistence.

;;; Code:
(require 'ert)
(require 'cl-lib)
(require 'sprite)
(require 'sprite-state)
(require 'desktop)

(defmacro sprite-state-test/with-directory (&rest body)
  "Run BODY with an isolated state directory and identity."
  (declare (indent 0) (debug t))
  `(let* ((noninteractive nil)
          (user-emacs-directory (make-temp-file "sprite-state-test-" t))
          (sprite-instance-id "work")
          (sprite--system-name-cached "host")
          (user-login-name "tester")
          (sprite-state-mappings nil)
          (sprite-state-locks-enabled nil)
          (sprite-state-auto-save-enabled nil)
          (sprite-state-desktop-enabled nil)
          (sprite-state-global-mode nil)
          (sprite-state--desktop-timer nil)
          (sprite-state--last-save-time nil)
          (sprite-state--restored-file nil)
          (sprite-state--active nil)
          (sprite-state--desktop-directory nil)
          (desktop-base-file-name desktop-base-file-name)
          (desktop-base-lock-name desktop-base-lock-name)
          (desktop-path desktop-path)
          (desktop-dirname desktop-dirname)
          (desktop-file-modtime desktop-file-modtime)
          (desktop-not-loaded-hook desktop-not-loaded-hook)
          (desktop-save desktop-save)
          (desktop-restore-frames desktop-restore-frames)
          (desktop-restore-in-current-display desktop-restore-in-current-display)
          (desktop-restore-eager desktop-restore-eager)
          (desktop-load-locked-desktop desktop-load-locked-desktop))
     (unwind-protect (progn ,@body)
       (when sprite-state--active
         (sprite-state-global-mode -1))
       (delete-directory user-emacs-directory t))))

(ert-deftest sprite-state/mappings-opt-in-and-later-declaration ()
  (sprite-state-test/with-directory
    (let ((sprite-state-mappings '((sprite-state-test-variable . "projects.el"))))
      (unwind-protect
          (progn
            (makunbound 'sprite-state-test-variable)
            (sprite-state-configure)
            (should (equal (symbol-value 'sprite-state-test-variable)
                           (sprite-state-path "projects.el")))
            (eval '(defcustom sprite-state-test-variable "default" "Test option." :type 'string))
            (should (equal (symbol-value 'sprite-state-test-variable)
                           (sprite-state-path "projects.el")))
            (should-not (featurep 'sprite-state-test-optional-package)))
        (makunbound 'sprite-state-test-variable)))))

(ert-deftest sprite-state/unselected-and-host-isolation ()
  (sprite-state-test/with-directory
    (let ((sprite-state-test-untouched 'original))
      (sprite-state-configure)
      (should (eq sprite-state-test-untouched 'original))
      (let ((first (sprite-state-path "projects.el"))
            (sprite--system-name-cached "other")
            (sprite-instance-id "second"))
        (should-not (equal first (sprite-state-path "projects.el")))))))

(ert-deftest sprite-state/named-locks-are-private ()
  (sprite-state-test/with-directory
    (let ((sprite-state-locks-enabled t)
          (lock-file-name-transforms nil))
      (sprite-state-configure)
      (let ((path (sprite-state-path "locks/")))
        (should (file-directory-p path))
        (should (= #o700 (file-modes path)))
        (should (equal (cadar lock-file-name-transforms) (concat path "\\1")))))))

(ert-deftest sprite-state/no-desktop-by-default-or-for-solo ()
  (sprite-state-test/with-directory
    (let ((calls 0))
      (cl-letf (((symbol-function 'run-with-idle-timer) (lambda (&rest _) (cl-incf calls)))
                ((symbol-function 'desktop-read) (lambda (&rest _) (cl-incf calls))))
        (sprite-state-global-mode 1)
        (sprite-state-global-mode -1)
        (let ((sprite-state-desktop-enabled t)
              (sprite-instance-id "solo"))
          (sprite-state-global-mode 1)
          (sprite-state-global-mode -1))
        (should (= calls 0))))))

(defvar sprite-state-desktop-idle-interval)

(ert-deftest sprite-state/desktop-idle-interval-is-configurable ()
  "Use the configured interval when scheduling desktop saves."
  (sprite-state-test/with-directory
    (let ((sprite-state-desktop-enabled t)
          (sprite-state-desktop-idle-interval 37)
          (scheduled nil))
      (cl-letf (((symbol-function 'run-with-idle-timer)
                 (lambda (&rest args) (setq scheduled args) 'fake-timer))
                ((symbol-function 'cancel-timer) #'ignore))
        (sprite-state-global-mode 1)
        (should (equal scheduled '(37 t sprite-state--desktop-save)))
        (sprite-state-global-mode -1)))))

(ert-deftest sprite-state/desktop-lifecycle ()
  (sprite-state-test/with-directory
    (let ((sprite-state-desktop-enabled t)
          (reads nil) (timers 0) (cancelled 0)
          (desktop-path nil) (desktop-base-file-name nil)
          (desktop-base-lock-name nil) (desktop-save nil)
          (desktop-restore-frames nil) (desktop-restore-in-current-display nil)
          (desktop-restore-eager nil) (desktop-load-locked-desktop nil))
      (make-directory (file-name-directory (sprite-state-path "desktop.el")) t)
      (write-region "" nil (sprite-state-path "desktop.el") nil 'silent)
      (cl-letf (((symbol-function 'desktop-read) (lambda (dir &rest _) (push dir reads) t))
                ((symbol-function 'run-with-idle-timer) (lambda (&rest _) (cl-incf timers) 'fake-timer))
                ((symbol-function 'cancel-timer) (lambda (_) (cl-incf cancelled))))
        (sprite-state-global-mode 1)
        (sprite-state-global-mode 1)
        (should (= (length reads) 1))
        (should (= timers 1))
        (should (equal (car reads) (file-name-directory (sprite-state-path "desktop.el"))))
        (should (equal desktop-base-file-name (sprite-state-file-prefix "desktop.el")))
        (should desktop-restore-eager)
        (sprite-state-global-mode -1)
        (sprite-state-global-mode -1)
        (should (= cancelled 1))
        (sprite-state-global-mode 1)
        (should (= (length reads) 1))
        (should (= timers 2))
        (sprite-state-global-mode -1)))))

(ert-deftest sprite-state/missing-desktop-does-not-read-fallback ()
  (sprite-state-test/with-directory
    (let ((sprite-state-desktop-enabled t) (reads 0))
      (cl-letf (((symbol-function 'desktop-read) (lambda (&rest _) (cl-incf reads)))
                ((symbol-function 'run-with-idle-timer) (lambda (&rest _) 'fake-timer))
                ((symbol-function 'cancel-timer) #'ignore))
        (sprite-state-global-mode 1)
        (should (= reads 0))
        (sprite-state-global-mode -1)))))

(ert-deftest sprite-state/solo-locks-use-process-path ()
  (sprite-state-test/with-directory
    (let ((sprite-instance-id "solo") (sprite-state-locks-enabled t)
          (lock-file-name-transforms nil))
      (cl-letf (((symbol-function 'user-uid) (lambda () 42424242))
                ((symbol-function 'emacs-pid) (lambda () 1234567))
                ((symbol-function 'temporary-file-directory)
                 (lambda () user-emacs-directory))
                ((symbol-function 'file-exists-p)
                 (lambda (path) (equal path user-emacs-directory))))
        (unwind-protect
            (progn
              (sprite-state-configure)
              (let ((path (file-name-concat user-emacs-directory "emacs-1234567")))
                (should (= #o700 (file-modes path)))
                (should (equal (cadar lock-file-name-transforms) (concat (file-name-as-directory path) "\\1")))))
          nil)))))

(ert-deftest sprite-state/save-cadence-and-failure ()
  (sprite-state-test/with-directory
    (let ((sprite-state--last-save-time (seconds-to-time 1000))
          (sprite-state--desktop-directory user-emacs-directory)
          (saves 0) (elapsed 100) (choice 99))
      (cl-letf (((symbol-function 'random) (lambda (_) choice))
                ((symbol-function 'time-since) (lambda (_) (seconds-to-time elapsed)))
                ((symbol-function 'current-time) (lambda () (seconds-to-time 1200)))
                ((symbol-function 'desktop-save) (lambda (_) (cl-incf saves))))
        (sprite-state--desktop-save)
        (should (= saves 0))
        (setq choice 39)
        (sprite-state--desktop-save)
        (should (= saves 1))
        (setq choice 99 elapsed 151)
        (sprite-state--desktop-save)
        (should (= saves 2))
        (cl-letf (((symbol-function 'desktop-save) (lambda (_) (error "write failed"))))
          (should-error (sprite-state--desktop-save)))))))

(ert-deftest sprite-state/read-failure-allows-retry ()
  (sprite-state-test/with-directory
    (let ((sprite-state-desktop-enabled t))
      (make-directory (file-name-directory (sprite-state-path "desktop.el")) t)
      (write-region "" nil (sprite-state-path "desktop.el") nil 'silent)
      (cl-letf (((symbol-function 'desktop-read) (lambda (&rest _) nil)))
        (should-error (sprite-state-global-mode 1))
        (should-not sprite-state-global-mode)
        (should-not sprite-state--desktop-timer)
        (should-not sprite-state--active)))))

(ert-deftest sprite-state/daemon-desktop-lock-policy ()
  (sprite-state-test/with-directory
    (let ((sprite-state-desktop-enabled t)
          (desktop-load-locked-desktop nil))
      (cl-letf (((symbol-function 'daemonp) (lambda () "work"))
                ((symbol-function 'run-with-idle-timer) (lambda (&rest _) 'fake-timer))
                ((symbol-function 'cancel-timer) #'ignore))
        (sprite-state-global-mode 1)
        (should desktop-load-locked-desktop)
        (should (equal desktop-base-lock-name
                       (sprite-state-file-prefix (format "desktop-%d.lock" (emacs-pid)))))
        (sprite-state-global-mode -1)))))

(defvar sprite-state-test--restored nil)

(ert-deftest sprite-state/real-desktop-read-selects-instance-file ()
  (sprite-state-test/with-directory
    (let* ((sprite-state-desktop-enabled t)
           (state-dir (file-name-directory (sprite-state-path "desktop.el")))
           (desktop-base-file-name (sprite-state-file-prefix "desktop.el"))
           (fallback (expand-file-name desktop-base-file-name user-emacs-directory))
           (target (expand-file-name desktop-base-file-name state-dir))
           (sprite-state-test--restored nil)
           (desktop-dirname nil) (desktop-delay-hook nil)
           (desktop-after-read-hook nil) (desktop-no-desktop-file-hook nil)
           (desktop-saved-frameset nil) (desktop-buffer-args-list nil))
      (make-directory state-dir t)
      (write-region "(setq sprite-state-test--restored 'fallback)" nil fallback nil 'silent)
      (cl-letf (((symbol-function 'run-with-idle-timer) (lambda (&rest _) 'fake-timer))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'desktop-owner) (lambda () nil))
                ((symbol-function 'desktop-claim-lock) #'ignore)
                ((symbol-function 'desktop-lazy-abort) #'ignore)
                ((symbol-function 'desktop-auto-save-disable) #'ignore)
                ((symbol-function 'desktop-restore-frameset) #'ignore)
                ((symbol-function 'switch-to-buffer) #'ignore)
                ((symbol-function 'bury-buffer) #'ignore)
                ((symbol-function 'walk-window-tree) #'ignore))
        (sprite-state-global-mode 1)
        (should-not sprite-state-test--restored)
        (sprite-state-global-mode -1)
        (write-region "(setq sprite-state-test--restored 'instance)" nil target nil 'silent)
        (sprite-state-global-mode 1)
        (should (eq sprite-state-test--restored 'instance))
        (sprite-state-global-mode -1)))))

(ert-deftest sprite-state/directory-failure-propagates ()
