;;; test-sprite-state-defaults.el --- Settings lifecycle tests -*- lexical-binding: t; -*-
;;; Commentary:
;; Check configuration settings and restoration.
;;; Code:
(require 'ert)
(require 'cl-lib)
(require 'savehist)
(require 'recentf)
(require 'sprite-state)

(defvar sprite-state-test-setting 'original)

(ert-deftest sprite-state-settings-apply-and-restore ()
  (let ((sprite-state-test-setting 'original)
        (sprite-state-settings '((sprite-state-test-setting . nil)
                                 (sprite-state-test-unbound . default)))
        (sprite-state--saved-settings nil))
    (makunbound 'sprite-state-test-unbound)
    (unwind-protect
        (progn
          (sprite-state--apply-settings)
          (should-not (default-value 'sprite-state-test-setting))
          (should (eq (default-value 'sprite-state-test-unbound) 'default))
          (sprite-state--restore-settings)
          (should (eq (default-value 'sprite-state-test-setting) 'original))
          (should-not (default-boundp 'sprite-state-test-unbound)))
      (sprite-state--restore-settings)
      (makunbound 'sprite-state-test-unbound))))

(ert-deftest sprite-state-preserves-preexisting-persistence-mode ()
  (let ((sprite-state--owned-modes nil)
        (savehist-mode t))
    (sprite-state--start-mode 'savehist 'savehist-mode)
    (should-not sprite-state--owned-modes)
    (sprite-state--stop-owned-modes)
    (should savehist-mode)))

(ert-deftest sprite-state-local-binding-survives-default-management ()
  (let ((sprite-state-settings '((sprite-state-test-setting . managed)))
        (sprite-state--saved-settings nil))
    (with-temp-buffer
      (setq-local sprite-state-test-setting 'local)
      (sprite-state--apply-settings)
      (should (eq sprite-state-test-setting 'local))
      (sprite-state--restore-settings)
      (should (eq sprite-state-test-setting 'local)))))

(ert-deftest sprite-state-remote-recent-file-retained ()
  (let ((sprite-state--saved-settings nil))
    (unwind-protect
        (progn
          (sprite-state--apply-settings)
          (should (recentf-keep-p "/ssh:example.invalid:/tmp/example")))
      (sprite-state--restore-settings))))

(ert-deftest sprite-state-rollback-on-persistence-start-error ()
  (let ((sprite-state-global-mode nil)
        (sprite-state--active nil)
        (sprite-state--owned-modes nil)
        (sprite-state--saved-settings nil)
        (sprite-state-settings '((sprite-state-test-setting . managed)))
        (sprite-state-savehist-enabled t)
        (sprite-state-recentf-enabled t)
        (sprite-state-desktop-enabled nil)
        (sprite-state-mappings nil)
        (sprite-state-locks-enabled nil)
        (sprite-state-auto-save-enabled nil)
        (savehist-mode nil) (recentf-mode nil))
    (cl-letf (((symbol-function 'savehist-mode)
               (lambda (arg) (setq savehist-mode (> arg 0))))
              ((symbol-function 'recentf-mode)
               (lambda (arg) (if (> arg 0) (error "startup failed")
                               (setq recentf-mode nil)))))
      (should-error (sprite-state-global-mode 1))
      (should-not savehist-mode)
      (should-not sprite-state--owned-modes)
      (should-not sprite-state-global-mode)
      (should (eq (default-value 'sprite-state-test-setting) 'original)))))

(ert-deftest sprite-state-repeat-lifecycle-preserves-preenabled-modes ()
  (let ((sprite-state-global-mode nil)
        (sprite-state--active nil)
        (sprite-state--owned-modes nil)
        (sprite-state--saved-settings nil)
        (sprite-state-settings nil)
        (sprite-state-savehist-enabled t) (sprite-state-recentf-enabled t)
        (sprite-state-desktop-enabled nil) (sprite-state-mappings nil)
        (sprite-state-locks-enabled nil) (sprite-state-auto-save-enabled nil)
        (savehist-mode t) (recentf-mode nil) (starts 0) (stops 0))
    (cl-letf (((symbol-function 'savehist-mode)
               (lambda (_) (error "preexisting mode was changed")))
              ((symbol-function 'recentf-mode)
               (lambda (arg) (setq recentf-mode (> arg 0))
                 (if (> arg 0) (cl-incf starts) (cl-incf stops)))))
      (unwind-protect
          (progn
            (sprite-state-global-mode 1)
            (sprite-state-global-mode 1)
            (should (= starts 1))
            (sprite-state-global-mode -1)
            (sprite-state-global-mode -1)
            (should (= stops 1))
            (should savehist-mode)
            (sprite-state-global-mode 1)
            (sprite-state-global-mode -1)
            (should (= starts 2))
            (should (= stops 2)))
        (when sprite-state-global-mode (sprite-state-global-mode -1))))))

(ert-deftest sprite-state-deferred-desktop-start ()
  (let ((sprite-state-global-mode nil) (sprite-state--active nil)
        (sprite-state--owned-modes nil) (sprite-state--saved-settings nil)
        (sprite-state-settings nil)
        (sprite-state-savehist-enabled nil) (sprite-state-recentf-enabled nil)
        (sprite-state-desktop-enabled t) (sprite-state-desktop-deferred t)
        (sprite-state-mappings nil) (sprite-state-locks-enabled nil)
        (sprite-state-auto-save-enabled nil) (calls 0))
    (cl-letf (((symbol-function 'sprite-state-start-desktop)
               (lambda () (setq calls (1+ calls)))))
      (unwind-protect
          (progn
            (sprite-state-global-mode 1)
            (should (= calls 0))
            (sprite-state-start-desktop)
            (should (= calls 1)))
        (sprite-state-global-mode -1)))))

(ert-deftest sprite-state-cleanup-after-save-error ()
  (let ((sprite-state-global-mode t) (sprite-state--active t)
        (sprite-state--owned-modes '(savehist-mode recentf-mode))
        (sprite-state--saved-settings nil)
        (sprite-state--desktop-timer nil) (savehist-mode t) (recentf-mode t)
        stopped)
    (cl-letf (((symbol-function 'savehist-save) (lambda (&rest _) (error "save failure")))
              ((symbol-function 'savehist-mode) (lambda (_) (push 'savehist stopped)))
              ((symbol-function 'recentf-mode) (lambda (_) (push 'recentf stopped))))
      (should-error (sprite-state-global-mode -1))
      (should (memq 'savehist stopped))
      (should (memq 'recentf stopped))
      (should-not sprite-state--owned-modes)
      (should-not sprite-state--active))))

(ert-deftest sprite-state-desktop-settings-managed-and-restored ()
  (require 'desktop)
  (let ((sprite-state-global-mode t)
        (sprite-state-desktop-enabled t)
        (sprite-state--desktop-timer nil)
        (sprite-state--saved-settings nil)
        (desktop-base-file-name "orig-desktop")
        (desktop-base-lock-name "orig-lock")
        (desktop-save 'orig-save)
        (dir (make-temp-file "sprite-desktop-" t)))
    (unwind-protect
        (cl-letf (((symbol-function 'sprite-instance-name) (lambda () "test"))
                  ((symbol-function 'sprite-state-path) (lambda (_) (expand-file-name "desktop.el" dir)))
                  ((symbol-function 'run-with-idle-timer) (lambda (&rest _) 'fake-timer))
                  ((symbol-function 'cancel-timer) #'ignore))
          (sprite-state-start-desktop)
          (should (equal desktop-base-file-name (sprite-state-file-prefix "desktop.el")))
          (should (equal desktop-base-lock-name
                         (sprite-state-file-prefix (format "desktop-%d.lock" (emacs-pid)))))
          (should (eq desktop-save t))
          (sprite-state--restore-settings)
          (should (equal desktop-base-file-name "orig-desktop"))
          (should (equal desktop-base-lock-name "orig-lock"))
          (should (eq desktop-save 'orig-save)))
      (sprite-state--restore-settings)
      (delete-directory dir t))))

(provide 'test-sprite-state-defaults)
;;; test-sprite-state-defaults.el ends here
