;;; test-sprite-reload.el --- Startup mode recovery tests -*- lexical-binding: t; -*-
;;; Commentary:
;; Tests for startup entries and recovery.
;;; Code:
(require 'ert)
(require 'sprite-batch)
(defvar sprite-test-reload-mode nil)
(defvar sprite-test-broken-mode nil)
(ert-deftest sprite/startup-runs-interleaved-entries ()
  "Run ordinary operations and mode entries in their configured order."
  (let ((noninteractive t)
        (order nil))
    (cl-letf (((symbol-function 'sprite-test-first) (lambda () (push 'first order)))
              ((symbol-function 'sprite-test-mode) (lambda (_) (push 'mode order)))
              ((symbol-function 'sprite-test-last) (lambda () (push 'last order))))
      (sprite-batch-startup '(sprite-test-first (:mode sprite-test-mode) sprite-test-last))
      (should (equal (nreverse order) '(first mode last))))))
(ert-deftest sprite/reload-recovers-after-failure ()
  (let ((sprite-startup-operations '(other (:mode sprite-test-broken-mode) other (:mode sprite-test-reload-mode)))
        (sprite-test-broken-mode nil)
        (sprite-test-reload-mode nil)
        (noninteractive t))
    (cl-letf (((symbol-function 'sprite-test-broken-mode) (lambda (_) (error "test")))
              ((symbol-function 'sprite-test-reload-mode) (lambda (_) (setq sprite-test-reload-mode t))))
      (sprite-state-reload)
      (should sprite-test-reload-mode))))
(ert-deftest sprite/reload-empty-does-not-run-startup ()
  (let ((sprite-startup-operations '(other (:mode sprite-test-reload-mode)))
        (sprite-test-reload-mode t))
    (cl-letf (((symbol-function 'sprite-batch-startup) (lambda (&rest _) (ert-fail "Unexpected startup"))))
      (should-not (sprite-state-reload)))))
(ert-deftest sprite/reload-unbound-mode ()
  (let ((sprite-startup-operations '(other (:mode sprite-test-unbound-mode)))
        (noninteractive t))
    (makunbound 'sprite-test-unbound-mode)
    (unwind-protect
        (cl-letf (((symbol-function 'sprite-test-unbound-mode)
                   (lambda (_) (set-default 'sprite-test-unbound-mode t))))
          (sprite-state-reload)
          (should (default-value 'sprite-test-unbound-mode)))
      (makunbound 'sprite-test-unbound-mode))))
(ert-deftest sprite/startup-reports-malformed-mode-at-execution ()
  "Report malformed entries when run and continue with later operations."
  (let ((noninteractive t)
        (sprite-test-reload-mode nil)
        (messages nil))
    (cl-letf (((symbol-function 'sprite-test-reload-mode)
               (lambda (_) (setq sprite-test-reload-mode t)))
              ((symbol-function 'message)
               (lambda (format-string &rest args)
                 (push (apply #'format format-string args) messages))))
      (seq-do (lambda (entry)
                (should-error (sprite-batch--startup-mode entry) :type 'user-error))
              '((:mode) (:mode one two) (:mode "one") (:mode nil) (:mode :keyword)))
      (sprite-batch-startup '((:mode one two) (:mode sprite-test-reload-mode)))
      (should sprite-test-reload-mode)
      (should (seq-some (lambda (msg) (string-match-p "exactly one mode symbol" msg))
                        messages)))))

(ert-deftest sprite/reload-reports-malformed-mode-at-execution ()
  "Recovery reports invalid mode entries without blocking subsequent modes."
  (let ((sprite-startup-operations '((:mode one two) (:mode sprite-test-reload-mode)))
        (sprite-state-reload-hook nil)
        (sprite-test-reload-mode nil)
        (noninteractive t)
        (messages nil))
    (cl-letf (((symbol-function 'sprite-test-reload-mode)
               (lambda (_) (setq sprite-test-reload-mode t)))
              ((symbol-function 'message)
               (lambda (format-string &rest args)
                 (push (apply #'format format-string args) messages))))
      (sprite-state-reload)
      (should sprite-test-reload-mode)
      (should (seq-some (lambda (msg) (string-match-p "exactly one mode symbol" msg))
                        messages)))))

(defvar sprite-test-reload-finished nil)
(defun sprite-test-reload--finished ()
  (setq sprite-test-reload-finished t))
(ert-deftest sprite/reload-runs-finished-hook-for-empty-batch ()
  (let ((sprite-startup-operations nil)
        (sprite-test-reload-finished nil)
        (sprite-state-reload-hook '(sprite-test-reload--finished)))
    (sprite-state-reload)
    (should sprite-test-reload-finished)))
(provide 'test-sprite-reload)
;;; test-sprite-reload.el ends here
